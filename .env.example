# ==============================================================================
# CYBER SENTINEL — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env (or set variables in your cloud deployment platform)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER NETWORK & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'test', or 'production'
NODE_ENV=development
# Server HTTP listening port (e.g., 5000 or 10000)
PORT=5000
# Target frontend URL for password reset links and redirection
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Comma-separated list of authorized origins. Wildcard (*) is strictly forbidden in production.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC SECRETS & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key for signing operator access JWTs (Minimum 32 characters required in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min
# JWT validity lifetime (e.g. 15m, 1h, 2h)
JWT_EXPIRES_IN=1h

# Secret key for signing rotating refresh tokens (Minimum 32 characters in production)
REFRESH_TOKEN_SECRET=replace_with_a_secure_refresh_token_secret_32_chars_min
# Refresh token validity lifetime (e.g. 7d, 30d)
REFRESH_TOKEN_EXPIRES_IN=7d

# Shared device secret token for authenticating endpoint telemetry agent streams
DEVICE_SECRET=replace_with_a_secure_device_token_16_chars_min

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection URI (e.g. postgres://user:pass@host:5432/cyber_sentinel)
# If left empty, Cyber Sentinel runs in offline persistent JSON storage mode.
DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. INITIAL SOC ADMINISTRATOR PROVISIONING
# ------------------------------------------------------------------------------
# Seed email address for the initial primary administrator account
INITIAL_ADMIN_EMAIL=admin@sentinel.local
# Seed password (12+ characters in production). If empty, a secure one-time bootstrap token is generated on startup.
INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 6. AI COPILOT INTEGRATION (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Google Gemini API key for autonomous ReAct agent and threat log explanation
GEMINI_API_KEY=
# Target Gemini model identifier (Default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 7. METRICS & OBSERVABILITY
# ------------------------------------------------------------------------------
# Optional Bearer token to protect Prometheus /api/metrics endpoint from unauthorized scraping
METRICS_TOKEN=

# ------------------------------------------------------------------------------
# 8. NOTIFICATION GATEWAYS (OPTIONAL)
# ------------------------------------------------------------------------------
# SMTP Email Gateway
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cyber Sentinel <no-reply@sentinel.local>

# Twilio SMS Gateway
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Fast2SMS Gateway (India)
FAST2SMS_API_KEY=
