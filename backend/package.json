{
  "name": "cyber-sentinel-backend",
  "version": "1.0.0",
  "description": "AI-assisted Cyber Threat Monitoring backend (Node/Express)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node ../tests/run_all_tests.js",
    "test:suites": "node ../tests/run_all_tests.js",
    "test:pipeline": "node test_capstone_pipeline.js",
    "benchmark": "node ../tests/benchmark_performance.js",
    "test:db": "node test_database_integration.js",
    "test:auth": "node test_authentication_security.js",
    "test:rbac": "node test_rbac_authorization.js",
    "test:device": "node test_device_enrollment.js",
    "test:telemetry": "node test_telemetry_security.js",
    "test:schema": "node test_event_schema_security.js",
    "test:detection": "node test_modular_detection_engine.js",
    "test:mitre": "node test_mitre_attack_integration.js",
    "test:incident": "node test_incident_management_workflow.js",
    "test:timeline": "node test_immutable_timeline.js",
    "test:malware": "node test_malware_static_analysis.js",
    "test:observability": "node test_observability.js",
    "test:upload": "node test_upload_security.js",
    "test:ai": "node test_ai_assistant_security.js",
    "test:actions": "node test_response_actions.js",
    "test:api-audit": "node test_api_security_audit.js",
    "test:worst-case": "node test_worst_case_scenarios.js",
    "test:adversarial": "node test_adversarial_security.js",
    "test:all": "node test_observability.js && node test_upload_security.js && node test_ai_assistant_security.js && node test_response_actions.js && node test_api_security_audit.js && node test_capstone_pipeline.js",
    "db:migrate": "node src/data/migrator.js",
    "build": "node -e \"console.log('Backend build complete')\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "systeminformation": "^5.33.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
