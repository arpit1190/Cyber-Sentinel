# ==============================================================================
# CYBER SENTINEL — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to backend/.env for local development or set in deployment platform
# ==============================================================================

# Server Network & Runtime
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Cross-Origin Resource Sharing (CORS) — Comma separated, exact URLs required
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Cryptographic Authentication Secrets (Minimum 32 characters in production)
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=replace_with_a_secure_refresh_secret_min_32_characters_long
REFRESH_TOKEN_EXPIRES_IN=7d

# Telemetry Endpoint Agent Ingestion Secret (Minimum 16 characters in production)
DEVICE_SECRET=replace_with_a_secure_device_secret_min_16_chars

# Production PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@hostname:5432/cyber_sentinel?sslmode=require

# Initial Primary Administrator Provisioning
INITIAL_ADMIN_EMAIL=admin@sentinel.ai
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_admin_password_min_12_chars

# AI Threat Analysis & Autonomous Agent (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Observability (Prometheus Metrics Scrape Authentication)
METRICS_TOKEN=

# Notification Delivery Gateways (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=Cyber Sentinel SOC <alerts@yourdomain.com>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

FAST2SMS_API_KEY=
